# Python cache
__pycache__/
*.py[cod]

# environments. The glob covers uv project environments pointed elsewhere with
# UV_PROJECT_ENVIRONMENT, e.g. .venv-313 — without it, a renamed one gets committed.
.venv*/

# build and packaging
build/
dist/
*.egg-info/
.eggs/

# test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# assessment output — a report is produced by a run, not committed
reports/

# datasets, model artefacts and scratch output (from the pre-restructure layout)
data/
dataset_paths/
model_paths/
model/
plots/

# Note: `notebooks/` was ignored in the pre-restructure layout. The tutorial lives in
# docs/tutorial_classification.ipynb and is tracked; anything under notebooks/ is scratch.
notebooks/
.ipynb_checkpoints/

# exported figures. The figure *builders* are the tracked artefact; a PNG of one is not.
*.png
*.jpg
*.jpeg
*.gif
*.svg

# editors and OS
.idea/
.vscode/
.DS_Store

# the exported tutorial site. Built from the committed notebooks by
# tools/build_docs_site.py and published by CI; never committed, because it is a
# derivative of files already in the repository.
site/
public/
